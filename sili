local function rand32()
    local x = G.Seed
    x = bxor(x,lshift(x,13))
    x = bxor(x,rshift(x,17))
    x = bxor(x,lshift(x,5))
    G.Seed = x
    return x
end

if not G.Z1 or G.ZVersion ~= G.Version then
    G.Z1, G.Z2, G.ZSide1, G.ZSide2 = {}, {}, rand32(), rand32()
    for p=1,12 do
        G.Z1[p], G.Z2[p] = {}, {}
        for s=0,127 do
            G.Z1[p][s+1], G.Z2[p][s+1] = rand32(), rand32()
        end
    end
    G.ZVersion = G.Version
end

local function newTT(bits)
    local size = lshift(1,bits)
    local tt = {k1={},k2={},mv={},dp={},sc={},fl={},age={},mask=size-1,size=size}
    for i=1,size do
        tt.k1[i],tt.k2[i],tt.mv[i],tt.dp[i],tt.sc[i],tt.fl[i],tt.age[i] = -1,-1,0,-1,0,0,0
    end
    return tt
end

if not G.TT or G.TT.size ~= lshift(1,G.HashBits) then
    G.TT = newTT(G.HashBits)
end

local function pst(piece,s)
    local t = PST[piece]
    local r = rshift(s,4)
    local f = band(s,15)
    return t[(7-r)*8+f+1]
end

local function hashBoard(B,side,castle,ep)
    local h1,h2 = 0,0
    for r=0,7 do
        local base=r*16
        for f=0,7 do
            local s=base+f
            local p=B[s]
            if p ~= 0 then
                local idx=p>0 and p or 6-p
                h1=bxor(h1,G.Z1[idx][s+1])
                h2=bxor(h2,G.Z2[idx][s+1])
            end
        end
    end
    h1=bxor(h1,castle*97531)
    h2=bxor(h2,castle*31337)
    if ep>=0 then
        h1=bxor(h1,G.Z1[1][band(ep,15)+1])
        h2=bxor(h2,G.Z2[1][band(ep,15)+1])
    end
    if side==BLACK then h1=bxor(h1,G.ZSide1); h2=bxor(h2,G.ZSide2) end
    return h1,h2
end

local function parseFEN(fen)
    if type(fen) ~= 'string' then return nil end
    local f={}
    for x in string.gmatch(fen,'%S+') do f[#f+1]=x end
    if #f<4 then return nil end
    local B={}
    for i=0,127 do B[i]=0 end
    local rank,file=7,0
    local map={P=1,N=2,B=3,R=4,Q=5,K=6,p=-1,n=-2,b=-3,r=-4,q=-5,k=-6}
    for c in string.gmatch(f[1],'.') do
        if c=='/' then rank=rank-1; file=0
        elseif c>='1' and c<='8' then file=file+tonumber(c)
        else
            if rank<0 or file>7 or not map[c] then return nil end
            B[rank*16+file]=map[c]
            file=file+1
        end
    end
    if rank~=0 and rank>=0 then return nil end
    local side=f[2]=='b' and BLACK or WHITE
    local castle=0
    if f[3]:find('K',1,true) then castle=castle+1 end
    if f[3]:find('Q',1,true) then castle=castle+2 end
    if f[3]:find('k',1,true) then castle=castle+4 end
    if f[3]:find('q',1,true) then castle=castle+8 end
    local ep=-1
    if f[4]~='-' then
        local ef=string.byte(f[4],1)-97
        local er=tonumber(string.sub(f[4],2,2))
        if ef>=0 and ef<=7 and er and er>=1 and er<=8 then ep=(er-1)*16+ef end
    end
    local kw,kb=-1,-1
    local phase,mg,eg,npmW,npmB=0,0,0,0,0
    for r=0,7 do
        for ff=0,7 do
            local s=r*16+ff
            local p=B[s]
            if p~=0 then
                local t=abs(p)
                if t==KING then if p>0 then kw=s else kb=s end end
                phase=phase+(PHASE[t] or 0)
                local v=VALUE[t]+pst(t,s)
                if p>0 then mg=mg+v; eg=eg+v else mg=mg-v; eg=eg-v end
                if p>0 and t>PAWN and t<KING then npmW=npmW+VALUE[t] end
                if p<0 and t>PAWN and t<KING then npmB=npmB+VALUE[t] end
            end
        end
    end
    if phase>24 then phase=24 end
    local h1,h2=hashBoard(B,side,castle,ep)
    return {
        board=B,side=side,castle=castle,ep=ep,half=tonumber(f[5]) or 0,full=tonumber(f[6]) or 1,
        kingW=kw,kingB=kb,phase=phase,mg=mg,eg=eg,npmW=npmW,npmB=npmB,h1=h1,h2=h2,
        stack={},ply=0,tt=G.TT,history={},killers={},counter={},nodes=0,qnodes=0,abort=false,
        deadline=0,nodeLimit=G.NodeLimit,maxDepth=G.MaxDepth,maxQDepth=G.MaxQDepth,
        yieldEnabled=G.Yield,lastCheck=0,timeSlice=G.TimeSlice,style=STYLE and STYLE[G.StyleName] or nil,
    }
end

